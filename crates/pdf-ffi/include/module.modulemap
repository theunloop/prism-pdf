// Clang module map for the Apple platforms. It is what lets Swift and Objective-C `import CPrismPDF`
// instead of reaching for a bridging header, and it is packaged beside prismpdf.h in the
// PrismPDF.xcframework the release pipeline builds (docs/native-artifacts.md).
//
// Unlike prismpdf.h this file is hand-written and not generated by cbindgen: it names the module and
// nothing else, so it only changes if the header is renamed.
// Keep the C module distinct from a future Swift product named `PrismPDF`. The module name is a
// consumer-facing compatibility contract, so this must be settled before the first artifact ships.
module CPrismPDF {
    header "prismpdf.h"
    export *
}
